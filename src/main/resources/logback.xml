<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="true">
	<property name="LOG_PATH" value="D:/logs" />

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>
				%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n
			</pattern>
		</encoder>
	</appender>

	<appender name="SERVLET_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>
				${LOG_PATH}/servlet/upload.%d{yyyy-MM-dd_HH-mm}.%i.log
			</fileNamePattern>
			<maxFileSize>1MB</maxFileSize>
			<maxHistory>3</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level - %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="CONSUMER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>
				${LOG_PATH}/consumer/db_insert.%d{yyyy-MM-dd_HH-mm}.%i.log
			</fileNamePattern>
			<maxFileSize>1MB</maxFileSize>
			<maxHistory>3</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level - %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="ASYNC_SERVLET" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="SERVLET_FILE" />
		<queueSize>10000</queueSize>
		<discardingThreshold>0</discardingThreshold>
		<includeCallerData>false</includeCallerData>
	</appender>

	<appender name="ASYNC_CONSUMER" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="CONSUMER_FILE" />
		<queueSize>10000</queueSize>
		<discardingThreshold>0</discardingThreshold>
		<includeCallerData>false</includeCallerData>
	</appender>

	<logger name="dev.sample.DataUploadServlet" level="INFO" additivity="false">
		<appender-ref ref="ASYNC_SERVLET" />
	</logger>

	<logger name="dev.sample.RabbitMQConsumer" level="INFO" additivity="false">
		<appender-ref ref="ASYNC_CONSUMER" />
	</logger>

	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>

</configuration>